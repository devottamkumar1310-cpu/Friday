# FRIDAY — environment template. Copy to `.env.local` and fill in.
# Never commit a real .env file. Secrets live in a managed store (NFR-3.9).

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres 16+. A Neon connection string, or any stock PostgreSQL — no
# third-party extensions are needed until Phase 3 (DATABASE_DESIGN D11).
# Migration 0000 installs citext, which ships with PostgreSQL.
DATABASE_URL="postgresql://user:password@host/friday?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Server-side pepper for session-token hashing. 32+ random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Public origin, used for OAuth callbacks and absolute links.
APP_URL="http://localhost:3000"

# Google OAuth (FR-1.1). Authorized redirect URI:
#   {APP_URL}/api/v1/auth/oauth/google/callback
# Leave blank to disable the Google button — email/password still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Observability ───────────────────────────────────────────────────────────
# Optional. Unset disables Sentry reporting; the logger still works.
SENTRY_DSN=""
LOG_LEVEL="info"

# ─── Later phases (documented now, unused in Phase 0) ────────────────────────
# ANTHROPIC_API_KEY=""
# REDIS_URL=""
# RESEND_API_KEY=""
