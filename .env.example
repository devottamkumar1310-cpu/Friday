# FRIDAY — environment template. Copy to `.env.local` and fill in.
# Never commit a real .env file. Secrets live in a managed store (NFR-3.9).

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres 16+. A Neon connection string, or any stock PostgreSQL — no
# third-party extensions are needed until Phase 3 (DATABASE_DESIGN D11).
# Migration 0000 installs citext, which ships with PostgreSQL.
DATABASE_URL="postgresql://user:password@host/friday?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Server-side pepper for session-token hashing. 32+ random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Public origin, used for OAuth callbacks and absolute links.
APP_URL="http://localhost:3000"

# Google OAuth (FR-1.1). Authorized redirect URI:
#   {APP_URL}/api/v1/auth/oauth/google/callback
# Leave blank to disable the Google button — email/password still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Observability ───────────────────────────────────────────────────────────
# Optional. Unset disables Sentry reporting; the logger still works.
SENTRY_DSN=""
LOG_LEVEL="info"

# ─── AI provider ─────────────────────────────────────────────────────────────
# Which vendor sits behind the ModelProvider interface (ADR-012). Switching is
# configuration, never a code change — no agent or service knows the difference.
#
#   anthropic  the blueprint's primary (SYSTEM_ARCHITECTURE §2.1)
#   google     Gemini, named there as the failover
#   fixture    recorded responses; no network, no key, no cost
#
# Leave unset to infer from whichever key is present (Anthropic wins if both
# are). With no key at all the app runs on fixtures — AI surfaces degrade
# honestly and the deterministic core loop is untouched (NFR-2.2).
AI_PROVIDER=""

ANTHROPIC_API_KEY=""

# Google AI Studio key. Standard keys look like "AIza..." (39 chars).
GOOGLE_API_KEY=""
# Optional: pin one Gemini model for every tier instead of the default mapping
# (deep→gemini-2.5-pro, balanced→gemini-2.5-flash, cheap→gemini-2.5-flash-lite).
GEMINI_MODEL=""

# ─── Later phases (documented now, unused) ───────────────────────────────────
# REDIS_URL=""
# RESEND_API_KEY=""
