# FRIDAY — Environment Variable Template
# Copy to .env.local and fill with real values. NEVER commit real secrets.

# ─── REQUIRED (server will not start without these) ─────────────────────────

# PostgreSQL connection string (Neon or any Postgres 16+)
DATABASE_URL=postgresql://user:password@host:5432/friday?sslmode=require

# HMAC pepper for session token hashing (32+ character random string)
AUTH_SECRET=generate-a-random-base64-string-of-at-least-32-chars

# ─── SECURITY / CORRECTNESS ─────────────────────────────────────────────────

# Canonical production origin (must be HTTPS in production)
APP_URL=https://your-domain.com

# Bearer token for /api/v1/cron/replan (use a long random string)
CRON_SECRET=another-long-random-string-for-cron-auth

# ─── GOOGLE OAUTH ───────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── AI PROVIDER ────────────────────────────────────────────────────────────

# Options: anthropic | google | fixture
AI_PROVIDER=google
GOOGLE_API_KEY=your-google-ai-studio-key
# ANTHROPIC_API_KEY=your-anthropic-key
# GEMINI_MODEL=gemini-2.5-flash

# ─── REVENUECAT ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=your-revenuecat-public-web-key

# ─── OBSERVABILITY ──────────────────────────────────────────────────────────

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info

# ─── OPTIONAL TUNING ────────────────────────────────────────────────────────

DATABASE_POOL_MAX=10
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/friday?sslmode=require
NEXT_PUBLIC_ENVIRONMENT=production
