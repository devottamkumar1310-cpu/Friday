{
  "name": "friday",
  "version": "0.1.0",
  "private": true,
  "description": "FRIDAY \u2014 an AI Learning Operating System",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "db:generate": "pnpm --filter @friday/db generate",
    "db:migrate": "pnpm --filter @friday/db migrate",
    "db:seed": "pnpm --filter @friday/db seed",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "pnpm --filter @friday/web e2e"
  },
  "devDependencies": {
    "@friday/config": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "fast-uri": ">=3.1.5",
      "js-yaml@>=4.0.0": ">=4.3.1",
      "rollup@>=3.0.0 <4.0.0": ">=3.30.0",
      "sharp": ">=0.35.0",
      "undici": ">=6.27.0",
      "vite": ">=6.4.3",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9"
    }
  }
}
